APP_NAME=TripVerse API
APP_ENV=development
DEBUG=true
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# PostgreSQL / Supabase Database connection string
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth Configuration
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-ANON-OR-PUBLISHABLE-KEY]
SUPABASE_SECRET=[YOUR-SERVICE-ROLE-SECRET]
SUPABASE_JWT_SECRET=[YOUR-JWT-SECRET]

# Google Gemini LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
