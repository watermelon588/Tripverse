APP_NAME=TripVerse API
APP_ENV=development
DEBUG=true
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# PostgreSQL / Neon Database connection string
# Format: postgresql+asyncpg://user:password@host:port/dbname?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./tripverse.db

